.control-action{border:1px solid var(--line);background:#fff;border-radius:8px;padding:6px 8px;color:#52657a;font-size:11px;font-weight:700}
.control-action:hover{border-color:#bdd9ec;color:var(--blue);background:#f4faff}
.control-action.danger:hover{border-color:#f5cdcd;color:#bd4141;background:#fff6f6}
.control-dash-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(260px,.85fr);gap:16px}
.control-dashboard-chart{height:220px;position:relative;width:100%}
.control-preview{display:grid;gap:9px}
.control-preview-item{display:flex;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid #eff3f6}
.control-preview-item:last-child{border:0}
.control-preview-dot{width:9px;height:9px;border-radius:50%;background:#2588ce;flex:0 0 auto}
.control-preview-info{flex:1;min-width:0}
.control-preview-info b{display:block;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.control-preview-info small{color:var(--muted);font-size:10px}
.control-preview-state{font-size:10px;font-weight:750;color:var(--blue);white-space:nowrap}
.control-toolbar{display:grid;grid-template-columns:minmax(180px,1fr) minmax(150px,190px) minmax(140px,170px);gap:9px;min-width:min(100%,520px)}
.control-help{font-size:11px;color:var(--muted);margin-top:10px}
.control-section-title{font-size:15px;font-weight:750;margin:0;color:var(--ink)}
.control-csv-actions{display:flex;gap:8px;flex-wrap:wrap}
@media(max-width:1050px){.control-layout{grid-template-columns:1fr}.control-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.control-dash-grid{grid-template-columns:1fr}.control-toolbar{grid-template-columns:1fr;min-width:0}.control-table-head{display:block}.control-table-head>div+div{margin-top:12px}.control-chart-box{height:250px}}
@media(max-width:430px){.control-kpi{padding:13px}.control-kpi-value{font-size:22px}.control-form .form-grid{grid-template-columns:1fr}.control-form .form-group.full{grid-column:auto}}


/* Banners de las secciones principales */
.section-banner{position:relative;min-height:205px;border-radius:18px;overflow:hidden;margin:-2px 0 22px;background:linear-gradient(110deg,#0d3457,#1769aa);box-shadow:var(--shadow);isolation:isolate}
.section-banner img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;object-position:center}
.section-banner:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(8,35,61,.94) 0%,rgba(8,45,78,.78) 48%,rgba(8,45,78,.20) 100%)}
.section-banner-content{position:relative;z-index:1;max-width:690px;padding:27px 30px;color:#fff}
.section-banner-kicker{color:#bfe7ff;font-size:10px;font-weight:800;letter-spacing:1.5px;margin-bottom:8px}
.section-banner h2{color:#fff;font-size:25px;line-height:1.18;letter-spacing:-.5px;margin:0 0 8px}
.section-banner p{color:#e2eff8;font-size:13px;margin:0;max-width:580px}
.section-banner-credit{position:absolute;right:11px;bottom:8px;color:#fff;font-size:9px;text-shadow:0 1px 3px #000;z-index:2}
.section-banner-credit a{color:#fff}
.activities-banner img{object-position:center 48%}
.calendar-banner img{object-position:center 50%}
.settings-banner img{object-position:center 45%}
.emoji-picker{display:flex;flex-wrap:wrap;gap:7px;padding:10px;border:1px solid var(--line);border-radius:11px;background:#f8fbfd}
.emoji-choice{width:38px;height:38px;border:1px solid #e1eaf1;border-radius:9px;background:#fff;display:grid;place-items:center;font-size:20px;transition:background .15s ease,border-color .15s ease,box-shadow .15s ease,transform .15s ease}
.emoji-choice:hover,.emoji-choice:focus-visible{background:#eaf5fc;border-color:#8fc5e8;box-shadow:0 3px 10px rgba(23,105,170,.12);transform:translateY(-1px);outline:none}
.emoji-choice.selected{background:#dff0fc;border-color:var(--blue);box-shadow:inset 0 0 0 1px var(--blue),0 3px 9px rgba(23,105,170,.12)}
@media(max-width:760px){.section-banner{min-height:220px}.section-banner:after{background:linear-gradient(90deg,rgba(8,35,61,.95),rgba(8,45,78,.62))}.section-banner-content{padding:23px 20px}.section-banner h2{font-size:21px}.section-banner-credit{right:9px;bottom:6px}}

</style>
</head>
<body>
<div class="app">
<aside class="sidebar" id="sidebar">
  <div class="brand"><div class="brandmark">✦</div><div><strong>Portal Digital</strong><small>Actividades & Objetivos</small></div></div>
  <div class="nav-label">Principal</div>
  <nav class="nav">
    <button class="active" data-page="dashboard"><span class="ico">▦</span>Dashboard</button>
    <button data-page="activities"><span class="ico">◷</span>Actividades</button>
    <button data-page="control"><span class="ico">▤</span>Control de actividades</button>
    <button data-page="objectives"><span class="ico">◎</span>Objetivos</button>
    <button data-page="calendar"><span class="ico">▦</span>Calendario</button>
    <button data-page="registrations"><span class="ico">♧</span>Inscripciones</button>
  </nav>
  <div class="nav-label">Administración</div>
  <nav class="nav">
    <button data-page="settings"><span class="ico">⚙</span>Configuración</button>
    <button data-page="legal"><span class="ico">⚖</span>Aspectos legales</button>
    <button data-page="project"><span class="ico">📘</span><span class="project-nav-label">Alfabetización en IA | Proyecto</span></button>
  </nav>
  <div class="side-bottom"><strong>Portal Digital v1.5</strong>Prototipo MVP · Datos guardados en este navegador</div>
</aside>
<main class="main">
  <header class="topbar">
    <div style="display:flex;align-items:center;gap:13px"><button class="iconbtn mobile-menu" id="menuBtn" aria-label="Abrir menú">☰</button><div class="crumb">Portal Digital <span style="color:#c0cbd5">/</span> <b id="crumb">Dashboard</b></div></div>
    <div class="top-actions"><button class="iconbtn" title="Ayuda" onclick="toast('Portal Digital · Prototipo MVP')">?</button><span class="user-label small muted">Administrador</span><div class="avatar">AD</div></div>
  </header>
  <div class="content">
    <section class="page active" id="page-dashboard">
      <div class="heading"><div><h1>¡Bienvenido al Portal Digital! 👋</h1><p>Centraliza tus actividades y monitorea los objetivos de tu equipo.</p></div><button class="btn btn-primary" onclick="openActivity()">＋ Nueva actividad</button></div>
      <div class="hero-banner">
        <img src="https://img.innovaciondigital360.com/wp-content/uploads/2026/01/26120401/Acuerdos-tecnologicos.jpg.webp" alt="Interacción entre una mano humana y una mano robótica alrededor de un símbolo de inteligencia artificial" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">
        <div class="hero-content">
          <div class="hero-kicker">COLABORACIÓN · INNOVACIÓN · ACCESIBILIDAD</div>
          <h2>Conectamos personas, actividades y tecnología</h2>
          <p>Un espacio digital para organizar iniciativas, facilitar la participación y avanzar juntos hacia objetivos compartidos.</p>
          <button class="btn" onclick="showPage('activities')">Explorar actividades <span aria-hidden="true">→</span></button>
        </div>
        <div class="hero-credit">Imagen: <a href="https://img.innovaciondigital360.com/wp-content/uploads/2026/01/26120401/Acuerdos-tecnologicos.jpg.webp" target="_blank" rel="noopener noreferrer">Innovación Digital 360</a></div>
      </div>
      <div class="stats">
        <div class="stat"><div><small>Actividades registradas</small><strong id="statActivities">0</strong></div><div class="stat-icon">◷</div></div>
        <div class="stat"><div><small>Próximas actividades</small><strong id="statUpcoming">0</strong></div><div class="stat-icon">▣</div></div>
        <div class="stat"><div><small>Inscripciones</small><strong id="statRegistrations">0</strong></div><div class="stat-icon">♧</div></div>
        <div class="stat"><div><small>Objetivos cumplidos</small><strong id="statGoals">0/0</strong></div><div class="stat-icon">◎</div></div>
      </div>

      <div class="panel" id="controlDashboardSummary" style="margin-bottom:20px">
        <div class="panel-head">
          <div><h3>Control de actividades</h3><span class="small muted">Resumen de tareas, horas y cumplimiento</span></div>
          <button class="btn btn-light btn-sm" onclick="showPage('control')">Abrir control →</button>
        </div>
        <div class="control-kpis">
          <div class="control-kpi"><span class="control-kpi-icon">◷</span><div class="control-kpi-label">Horas acumuladas</div><div class="control-kpi-value" id="dashControlHours">0 h</div><div class="control-kpi-sub">Horas reales dedicadas</div></div>
          <div class="control-kpi"><span class="control-kpi-icon">↗</span><div class="control-kpi-label">Avance global</div><div class="control-kpi-value" id="dashControlProgress">0%</div><div class="control-kpi-sub">Ponderado por horas estimadas</div></div>
          <div class="control-kpi"><span class="control-kpi-icon">✎</span><div class="control-kpi-label">Tareas pendientes</div><div class="control-kpi-value" id="dashControlPending">0</div><div class="control-kpi-sub">Pendientes o en progreso</div></div>
          <div class="control-kpi"><span class="control-kpi-icon">✓</span><div class="control-kpi-label">Tasa de cumplimiento</div><div class="control-kpi-value" id="dashControlRate">0%</div><div class="control-kpi-sub" id="dashControlRateSub">0 de 0 completadas</div></div>
        </div>
        <div class="control-dash-grid">
          <div><div class="panel-head"><h3>Horas por categoría</h3><span class="small muted">Estimadas vs. reales</span></div><div class="control-dashboard-chart"><canvas id="controlDashboardChart" role="img" aria-label="Comparación de horas estimadas y reales por categoría"></canvas></div></div>
          <div><div class="panel-head"><h3>Actividad reciente</h3><span class="small muted">Control de tareas</span></div><div class="control-preview" id="controlDashboardPreview"></div></div>
        </div>
      </div>
      <div class="grid2">
        <div class="panel"><div class="panel-head"><h3>Próximas actividades</h3><button class="btn btn-light btn-sm" onclick="showPage('activities')">Ver todas →</button></div><div class="activity-list" id="dashboardActivities"></div></div>
        <div class="panel"><div class="panel-head"><h3>Progreso de objetivos</h3><button class="btn btn-light btn-sm" onclick="showPage('objectives')">Ver objetivos →</button></div><div class="progress-wrap" id="dashboardGoals"></div></div>
      </div>
      <div class="panel"><div class="panel-head"><h3>Accesos rápidos</h3><span class="small muted">Gestiona tu portal</span></div><div class="setting-actions"><button class="btn btn-light" onclick="openActivity()">＋ Crear actividad</button><button class="btn btn-light" onclick="showPage('control')">▤ Control de actividades</button><button class="btn btn-light" onclick="openObjective()">◎ Registrar objetivo</button><button class="btn btn-light" onclick="showPage('registrations')">♧ Ver inscripciones</button><button class="btn btn-light" onclick="showPage('calendar')">▦ Abrir calendario</button></div></div>
    </section>
    <section class="page" id="page-activities">
      <div class="heading"><div><h1>Actividades y eventos</h1><p>Organiza, publica y administra las actividades de tu comunidad.</p></div><button class="btn btn-primary" onclick="openActivity()">＋ Nueva actividad</button></div>
      <div class="section-banner activities-banner">
        <img src="https://www.sonda.com/images/sondanewsitelibraries/default-library/banner-nota-iac68cab6c-b0fc-46cf-9a84-a608915ae777.png" alt="Banner de tecnología e inteligencia artificial para la sección de actividades" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">
        <div class="section-banner-content"><div class="section-banner-kicker">PARTICIPACIÓN · ORGANIZACIÓN · COLABORACIÓN</div><h2>Actividades que conectan a las personas</h2><p>Publica eventos, comparte información y facilita la participación de tu comunidad desde un solo lugar.</p></div>
        <div class="section-banner-credit"><a href="https://www.sonda.com/images/sondanewsitelibraries/default-library/banner-nota-iac68cab6c-b0fc-46cf-9a84-a608915ae777.png" target="_blank" rel="noopener noreferrer">Imagen: SONDA</a></div>
      </div>
      <div class="toolbar"><div class="search"><span>⌕</span><input id="activitySearch" placeholder="Buscar actividad..." oninput="renderActivities()"></div><select id="activityFilter" style="max-width:190px" onchange="renderActivities()"><option value="">Todas las categorías</option></select><select id="statusFilter" style="max-width:160px" onchange="renderActivities()"><option value="">Todos los estados</option><option>Publicada</option><option>Borrador</option><option>Finalizada</option><option>Cancelada</option></select></div>
      <div class="cards" id="activityCards"></div>
    </section>

    <section class="page" id="page-control">
      <div class="control-banner">
        <div class="control-banner-content">
          <div class="control-banner-text">
            <div class="control-banner-kicker">GESTIÓN · TIEMPOS · CUMPLIMIENTO</div>
            <h1>Control de actividades</h1>
            <p>Registra tareas, estima y compara horas, define prioridades y monitorea el cumplimiento.</p>
          </div>
          <div class="control-csv-actions">
          <button class="btn btn-light" onclick="exportControlCSV()">↓ Exportar tareas CSV</button>
          <button class="btn btn-light" onclick="exportControlJSON()">↓ Exportar respaldo JSON</button>
          <button class="btn btn-light" onclick="$('controlJsonImport').click()">↑ Importar JSON</button>
          <input id="controlJsonImport" type="file" accept=".json,application/json" style="display:none" aria-label="Seleccionar respaldo JSON de actividades" onchange="importControlJSON(event)">
          <button class="btn btn-light" onclick="resetControlDemo()">↻ Restablecer demo</button>
          <button class="btn btn-primary" onclick="exportPortalCSV()">↓ Exportar todos los datos CSV</button>
        </div>
        </div>
      </div>

      <div class="control-kpis" aria-label="Indicadores del control de actividades">
        <div class="control-kpi"><span class="control-kpi-icon">◷</span><div class="control-kpi-label">Horas acumuladas</div><div class="control-kpi-value" id="ctlHours">0 h</div><div class="control-kpi-sub">Horas reales dedicadas</div></div>
        <div class="control-kpi"><span class="control-kpi-icon">↗</span><div class="control-kpi-label">Avance global</div><div class="control-kpi-value" id="ctlProgress">0%</div><div class="track" style="margin-top:10px"><div class="fill" id="ctlProgressBar" style="width:0%"></div></div><div class="control-kpi-sub">Ponderado por horas estimadas</div></div>
        <div class="control-kpi"><span class="control-kpi-icon">✎</span><div class="control-kpi-label">Tareas pendientes</div><div class="control-kpi-value" id="ctlPending">0</div><div class="control-kpi-sub">Pendientes o en progreso</div></div>
        <div class="control-kpi"><span class="control-kpi-icon">✓</span><div class="control-kpi-label">Tasa de cumplimiento</div><div class="control-kpi-value" id="ctlRate">0%</div><div class="control-kpi-sub" id="ctlRateSub">0 de 0 completadas</div></div>
      </div>

      <div class="control-layout">
        <section class="panel" aria-labelledby="control-form-title">
          <div class="panel-head"><h3 id="control-form-title" class="control-section-title">Nueva actividad</h3><button id="controlCancelEdit" class="btn btn-light btn-sm" type="button" style="display:none">Cancelar edición</button></div>
          <form id="controlActivityForm" class="control-form" novalidate>
            <div><label for="ctlName">Nombre de la actividad *</label><input id="ctlName" maxlength="120" required placeholder="Ej. Preparar informe mensual"></div>
            <div><label for="ctlCategory">Categoría *</label><select id="ctlCategory" required><option value="">Selecciona categoría</option><option>Trabajo</option><option>Estudio</option><option>Proyecto Personal</option><option>Tareas Operativas</option><option>Salud/Bienestar</option></select></div>
            <div class="form-grid">
              <div><label for="ctlEstimated">Horas estimadas *</label><input id="ctlEstimated" type="number" min="0.5" max="10000" step="0.5" required placeholder="Ej. 8"></div>
              <div><label for="ctlReal">Horas reales *</label><input id="ctlReal" type="number" min="0" max="10000" step="0.5" required placeholder="Ej. 3.5"></div>
            </div>
            <div><label for="ctlDate">Fecha límite / ejecución *</label><input id="ctlDate" type="date" required></div>
            <div class="form-grid">
              <div><label for="ctlPriority">Prioridad *</label><select id="ctlPriority" required><option>Alta</option><option selected>Media</option><option>Baja</option></select></div>
              <div><label for="ctlState">Estado *</label><select id="ctlState" required><option>Pendiente</option><option>En progreso</option><option>Completada</option></select></div>
            </div>
            <button id="controlSubmit" type="submit" class="btn btn-primary" style="width:100%">＋ Registrar actividad</button>
          </form>
          <p class="control-help">Los cambios se guardan en el almacenamiento local de este navegador.</p><p class="control-help">El archivo CSV completo puede incluir nombres y correos de participantes. Guárdalo en un lugar protegido y compártelo solo con personas autorizadas.</p>
        </section>

        <section class="panel" aria-labelledby="control-chart-title">
          <div class="panel-head"><div><h3 id="control-chart-title" class="control-section-title">Horas por categoría</h3><p class="small muted" style="margin:4px 0 0">Comparativa de horas estimadas frente a horas reales</p></div></div>
          <div class="control-chart-box"><canvas id="controlChart" role="img" aria-label="Gráfico de barras con horas estimadas y reales por categoría"></canvas></div>
        </section>
      </div>

      <section class="panel" aria-labelledby="control-table-title">
        <div class="control-table-head">
          <div><h3 id="control-table-title" class="control-section-title">Control de actividades</h3><p id="controlTableCount" class="small muted" style="margin:4px 0 0" aria-live="polite">Mostrando 0 actividades</p></div>
          <div class="control-toolbar">
            <input id="controlSearch" type="search" placeholder="Buscar actividad…" aria-label="Buscar actividad">
            <select id="controlCategoryFilter" aria-label="Filtrar por categoría"><option value="">Todas las categorías</option><option>Trabajo</option><option>Estudio</option><option>Proyecto Personal</option><option>Tareas Operativas</option><option>Salud/Bienestar</option></select>
            <select id="controlStateFilter" aria-label="Filtrar por estado"><option value="">Todos los estados</option><option>Pendiente</option><option>En progreso</option><option>Completada</option></select>
          </div>
        </div>
        <div class="table-wrap">
          <table class="control-table"><thead><tr><th>Tarea</th><th>Categoría</th><th>Horas reales / estimadas</th><th>Prioridad</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="controlTableBody"></tbody></table>
        </div>
        <p class="control-help">Puedes cambiar el estado desde la etiqueta, editar los datos o eliminar un registro. La exportación CSV incluye todos los registros, aunque haya filtros activos.</p>
      </section>
    </section>
    <section class="page" id="page-objectives">
      <div class="heading"><div><h1>Gestión de objetivos</h1><p>Define metas, asigna responsables y monitorea los avances.</p></div><button class="btn btn-primary" onclick="openObjective()">＋ Nuevo objetivo</button></div>
      <div class="stats" style="grid-template-columns:repeat(3,1fr)"><div class="stat"><div><small>Total objetivos</small><strong id="goalTotal">0</strong></div><div class="stat-icon">◎</div></div><div class="stat"><div><small>En desarrollo</small><strong id="goalActive">0</strong></div><div class="stat-icon">↗</div></div><div class="stat"><div><small>Cumplidos</small><strong id="goalDone">0</strong></div><div class="stat-icon">✓</div></div></div>
      <div class="toolbar"><div class="search"><span>⌕</span><input id="goalSearch" placeholder="Buscar objetivo..." oninput="renderObjectives()"></div><select id="goalFilter" style="max-width:190px" onchange="renderObjectives()"><option value="">Todos los estados</option><option>Pendiente</option><option>En desarrollo</option><option>En revisión</option><option>Cumplido</option><option>Atrasado</option></select></div>
      <div class="objective-grid" id="objectiveCards"></div>
    </section>
    <section class="page" id="page-calendar">
      <div class="heading"><div><h1>Calendario de actividades</h1><p>Consulta la planificación de eventos por fecha.</p></div><button class="btn btn-primary" onclick="openActivity()">＋ Nueva actividad</button></div>
      <div class="section-banner calendar-banner">
        <img src="https://www.sonda.com/images/sondanewsitelibraries/sonda_2024/industrias/banner-conoce/banner_conoce_nuestras_redes.jpg" alt="Imagen de redes y conectividad para la sección de calendario" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">
        <div class="section-banner-content"><div class="section-banner-kicker">PLANIFICACIÓN · COORDINACIÓN · TIEMPO</div><h2>Coordina cada actividad y encuentro</h2><p>Visualiza las fechas importantes, organiza la agenda y mantén las actividades de tu equipo conectadas.</p></div>
        <div class="section-banner-credit"><a href="https://www.sonda.com/images/sondanewsitelibraries/sonda_2024/industrias/banner-conoce/banner_conoce_nuestras_redes.jpg" target="_blank" rel="noopener noreferrer">Imagen: SONDA</a></div>
      </div>
      <div class="panel"><div class="calendar-head"><button class="btn btn-light btn-sm" onclick="changeMonth(-1)">← Anterior</button><h3 id="monthTitle" style="margin:0"></h3><button class="btn btn-light btn-sm" onclick="changeMonth(1)">Siguiente →</button></div><div class="calendar-scroll"><div class="calendar-grid" id="calendarGrid"></div></div></div>
    </section>
    <section class="page" id="page-registrations">
      <div class="heading"><div><h1>Inscripciones</h1><p>Consulta las personas inscritas en las actividades publicadas.</p></div><button class="btn btn-light" onclick="exportCSV()">↓ Exportar CSV</button></div>
      <div class="stats" style="grid-template-columns:repeat(2,1fr)"><div class="stat"><div><small>Inscripciones totales</small><strong id="regTotal">0</strong></div><div class="stat-icon">♧</div></div><div class="stat"><div><small>Actividades con inscritos</small><strong id="regEvents">0</strong></div><div class="stat-icon">◷</div></div></div>
      <div class="toolbar"><div class="search"><span>⌕</span><input id="regSearch" placeholder="Buscar participante o actividad..." oninput="renderRegistrations()"></div></div>
      <div class="table-wrap"><table class="data-table"><thead><tr><th>Participante</th><th>Correo electrónico</th><th>Actividad</th><th>Fecha de inscripción</th><th>Acción</th></tr></thead><tbody id="registrationRows"></tbody></table></div>
      <p class="small muted" style="margin-top:12px">Los datos de participantes son privados y se almacenan únicamente en este navegador en esta versión de demostración.</p>
    </section>
    <section class="page" id="page-settings">
      <div class="heading"><div><h1>Configuración</h1><p>Personaliza el portal y administra los datos del prototipo.</p></div></div>
