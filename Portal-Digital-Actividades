function saveActivity(){const form=$('activityForm');if(!form.reportValidity())return;const obj={id:editingId||uid(),title:$('aTitle').value.trim(),description:$('aDesc').value.trim(),category:$('aCategory').value,emoji:$('aEmoji').value.trim()||'📌',date:$('aDate').value,endDate:$('aEndDate').value,start:$('aStart').value,end:$('aEnd').value,place:$('aPlace').value.trim(),mode:$('aMode').value,resources:$('aResources').value.trim(),responsible:$('aResponsible').value.trim(),capacity:$('aCapacity').value===''?null:Number($('aCapacity').value),status:$('aStatus').value,link:$('aLink').value.trim()};if(obj.endDate&&obj.endDate<obj.date){toast('La fecha de término no puede ser anterior al inicio.');return}const i=data.activities.findIndex(x=>x.id===obj.id);if(i>=0)data.activities[i]=obj;else data.activities.push(obj);save();closeModal();renderAll();toast(i>=0?'Actividad actualizada':'Actividad creada correctamente')}
