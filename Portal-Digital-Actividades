function renderCalendar(){const y=calDate.getFullYear(),m=calDate.getMonth();$('monthTitle').textContent=calDate.toLocaleDateString('es-CL',{month:'long',year:'numeric'});const first=new Date(y,m,1),start=(first.getDay()+6)%7,days=new Date(y,m+1,0).getDate(),prev=new Date(y,m,0).getDate();let cells='';['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].forEach(d=>cells+=`<div class="cal-dayname">${d}</div>`);for(let i=0;i<42;i++){let day,dt,muted=false;if(i<start){day=prev-start+i+1;dt=new Date(y,m-1,day);muted=true}else if(i>=start+days){day=i-start-days+1;dt=new Date(y,m+1,day);muted=true}else{day=i-start+1;dt=new Date(y,m,day)}const iso=`${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}-${String(dt.getDate()).padStart(2,'0')}`;const ev=data.activities.filter(a=>a.date===iso);cells+=`<div class="cal-cell ${muted?'muted-day':''}"><div class="cal-num">${day}</div>${ev.slice(0,3).map(a=>`<div class="cal-event" title="${esc(a.title)}">${esc(a.emoji)} ${esc(a.title)}</div>`).join('')}${ev.length>3?`<small>+${ev.length-3} más</small>`:''}</div>`}$('calendarGrid').innerHTML=cells}
function changeMonth(n){calDate.setMonth(calDate.getMonth()+n);renderCalendar()}
function renderRegistrations(){const q=($('regSearch')?.value||'').toLowerCase();const list=data.registrations.filter(r=>(r.name+' '+r.email+' '+(data.activities.find(a=>a.id===r.activityId)?.title||'')).toLowerCase().includes(q));$('regTotal').textContent=data.registrations.length;$('regEvents').textContent=new Set(data.registrations.map(r=>r.activityId)).size;$('registrationRows').innerHTML=list.length?list.map(r=>`<tr><td><b>${esc(r.name)}</b></td><td>${esc(r.email)}</td><td>${esc(data.activities.find(a=>a.id===r.activityId)?.title||'Actividad eliminada')}</td><td>${fmtDate(r.created)}</td><td><button class="btn btn-danger btn-sm" onclick="deleteRegistration('${r.id}')">Eliminar</button></td></tr>`).join(''):'<tr><td colspan="5" class="empty">No hay inscripciones registradas.</td></tr>'}
function deleteRegistration(id){if(!confirm('¿Eliminar esta inscripción?'))return;data.registrations=data.registrations.filter(r=>r.id!==id);save();renderAll()}
function renderSettings(){$('orgName').value=data.settings.org||'';$('adminName').value=data.settings.admin||'';$('categoryList').innerHTML=data.categories.map((c,i)=>`<div style="display:flex;justify-content:space-between;align-items:center;background:#f7fafc;padding:8px 10px;border-radius:8px"><span>${esc(c)}</span><button class="btn btn-danger btn-sm" onclick="removeCategory(${i})">Eliminar</button></div>`).join('');$('activityFilter').innerHTML='<option value="">Todas las categorías</option>'+data.categories.map(c=>`<option>${esc(c)}</option>`).join('')}
function saveSettings(){data.settings={org:$('orgName').value.trim()||'Mi organización',admin:$('adminName').value.trim()||'Administrador'};save();toast('Configuración guardada')}
function addCategory(){const v=$('newCategory').value.trim();if(!v)return;if(data.categories.some(c=>c.toLowerCase()===v.toLowerCase())){toast('La clasificación ya existe');return}data.categories.push(v);$('newCategory').value='';save();renderSettings();toast('Clasificación agregada')}
function removeCategory(i){if(!confirm('¿Eliminar esta clasificación?'))return;data.categories.splice(i,1);save();renderSettings()}
function renderAll(){renderDashboard();renderActivities();renderObjectives();renderCalendar();renderRegistrations();renderSettings();renderControlTable();renderControlDashboard()}
function exportJSON(){const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});downloadBlob(blob,'portal-digital-respaldo.json')}
function exportCSV(){const rows=[['Nombre','Correo','Actividad','Fecha inscripción'],...data.registrations.map(r=>[r.name,r.email,data.activities.find(a=>a.id===r.activityId)?.title||'',r.created])];const csv=rows.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(';')).join('\r\n');downloadBlob(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),'inscripciones.csv')}
function downloadBlob(blob,name){const a=document.createElement('a'),url=URL.createObjectURL(blob);a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}
function importJSON(e){const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const d=JSON.parse(reader.result);if(!d||!Array.isArray(d.activities)||!Array.isArray(d.objectives)||!Array.isArray(d.registrations)||!Array.isArray(d.categories)||(d.controlActivities!==undefined&&!Array.isArray(d.controlActivities)))throw Error();if(!confirm('La importación reemplazará los datos actuales. ¿Continuar?'))return;data={...data,...d,controlActivities:Array.isArray(d.controlActivities)?d.controlActivities.map(sanitizarControlActivity).filter(Boolean):[]};save();renderAll();toast('Respaldo importado correctamente')}catch(err){toast('El archivo no tiene un respaldo válido')}e.target.value=''};reader.readAsText(file)}
function resetData(){if(!confirm('Esto eliminará todos los datos guardados en este navegador. ¿Continuar?'))return;data={activities:[],objectives:[],registrations:[],controlActivities:[],categories:[...defaultCategories],settings:{org:'Mi organización',admin:'Administrador'}};save();renderAll();toast('Datos restablecidos')}
function loadDemo(){if(data.activities.length||data.objectives.length){if(!confirm('Se agregarán ejemplos a los datos existentes. ¿Continuar?'))return}const d=today();const plus=n=>{const x=new Date(d+'T12:00:00');x.setDate(x.getDate()+n);return x.toISOString().slice(0,10)};data.activities.push({id:uid(),title:'Taller de innovación digital',description:'Espacio colaborativo para explorar herramientas digitales y nuevas ideas.',category:'Taller Deportivo',emoji:'💡',date:plus(3),endDate:'',start:'10:00',end:'12:00',place:'Sala de innovación',mode:'Presencial',resources:'Proyector y computadores',responsible:'Equipo de coordinación',capacity:30,status:'Publicada',link:''},{id:uid(),title:'Conversatorio: comunidad y participación',description:'Encuentro para compartir experiencias y propuestas de mejora.',category:'Conversatorio',emoji:'💬',date:plus(8),endDate:'',start:'15:00',end:'16:30',place:'Auditorio',mode:'Híbrida',resources:'Micrófono',responsible:'Coordinación',capacity:50,status:'Publicada',link:''});data.objectives.push({id:uid(),title:'Realizar 4 actividades comunitarias',description:'Organizar instancias de encuentro y participación.',owner:'Coordinación',start:d,due:plus(30),status:'En desarrollo',progress:50},{id:uid(),title:'Mejorar la comunicación interna',description:'Centralizar información y difundir actividades.',owner:'Equipo de comunicaciones',start:d,due:plus(20),status:'Pendiente',progress:15});save();renderAll();toast('Ejemplos agregados')}
$('controlActivityForm').addEventListener('submit',saveControlActivity);
$('controlCancelEdit').addEventListener('click',resetControlForm);
$('controlTableBody').addEventListener('click',onControlTableClick);
$('controlSearch').addEventListener('input',renderControlTable);
$('controlCategoryFilter').addEventListener('change',renderControlTable);
$('controlStateFilter').addEventListener('change',renderControlTable);
$('ctlDate').value=today();
initControlCharts();
load();renderAll();resetControlForm();
// Inscripción pública de demostración mediante hash. Requiere que el sitio esté publicado en una URL accesible.
if(location.hash.startsWith('#inscripcion-')){const aid=location.hash.slice(13);const a=data.activities.find(x=>x.id===aid);if(a){openModal('Inscripción · '+a.title,`<form id="publicReg" class="form-grid"><div class="form-group full"><p>${esc(a.description||'')}</p></div><div class="form-group full"><label>Nombre completo *</label><input id="rName" required maxlength="100"></div><div class="form-group full"><label>Correo electrónico *</label><input id="rEmail" type="email" required maxlength="150"></div></form>`,`<button class="btn btn-primary" onclick="submitRegistration('${a.id}')">Confirmar inscripción</button>`)}}
function submitRegistration(aid){const f=$('publicReg');if(!f.reportValidity())return;const a=data.activities.find(x=>x.id===aid);if(a.capacity!==null&&data.registrations.filter(r=>r.activityId===aid).length>=a.capacity){toast('Lo sentimos, no quedan cupos');return}const email=$('rEmail').value.trim().toLowerCase();if(data.registrations.some(r=>r.activityId===aid&&r.email.toLowerCase()===email)){toast('Este correo ya está inscrito');return}data.registrations.push({id:uid(),activityId:aid,name:$('rName').value.trim(),email,created:today()});save();closeModal();toast('¡Inscripción registrada!')}
</script>
