<div class="form-group full">
<label for="aEmoji">Icono de la actividad</label>
<div class="emoji-picker" id="activityEmojiPicker" aria-label="Seleccionar icono para la actividad">
${['📌','🎓','💬','🌱','🏃','🧠','🎨','🛠️','🤝','🧪','🏆','💻','🎭','🎯','🚌','🔔','📚','⚽','🎤','🌍','💡','🎉','🧩','🚀'].map(icon=>`<button type="button" class="emoji-choice ${(a.emoji||'📌')===icon?'selected':''}" data-emoji="${esc(icon)}" aria-label="Seleccionar ${esc(icon)}" aria-pressed="${(a.emoji||'📌')===icon}">${esc(icon)}</button>`).join('')}
</div>
<input id="aEmoji" maxlength="8" value="${esc(a.emoji||'📌')}" placeholder="También puedes escribir un emoji" style="margin-top:8px">
<small class="muted">Selecciona un icono de la colección o escribe uno propio.</small>
</div>
<div class="form-group"><label for="aDate">Fecha de inicio *</label><input type="date" id="aDate" required value="${a.date||''}"></div>
