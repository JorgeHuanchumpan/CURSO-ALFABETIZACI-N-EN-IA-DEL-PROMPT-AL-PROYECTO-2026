function activityDetails(id){const a=data.activities.find(x=>x.id===id);if(!a)return;const url=a.link||`${location.href.split('#')[0]}#inscripcion-${a.id}`;openModal('Detalle de actividad',`<div class="qr-box"><div style="font-size:35px">${esc(a.emoji)}</div><h3>${esc(a.title)}</h3><p class="muted">${esc(a.description||'Sin descripción')}</p><p><b>${fmtDate(a.date)}</b> · ${esc(a.start||'Hora por definir')} · ${esc(a.place||'Lugar por definir')}</p><div style="margin:12px auto"><img alt="Código QR de inscripción" src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(url)}"></div><p class="small muted">El QR utiliza un servicio externo. El enlace debe ser público para que otros dispositivos puedan acceder.</p><input id="copyLink" readonly value="${esc(url)}"></div>`,`<button class="btn btn-light" onclick="closeModal()">Cerrar</button><button class="btn btn-light" onclick="copyActivityLink()">Copiar enlace</button><button class="btn btn-primary" onclick="downloadQR('${encodeURIComponent(url)}')">Abrir QR</button>`)}
