function drawCategoryHoursCanvas(canvasId){
  const canvas=$(canvasId);
  if(!canvas)return;
  const parent=canvas.parentElement;
  const rect=parent.getBoundingClientRect();
  const width=Math.max(rect.width||0,320);
  const height=Math.max(rect.height||0,canvasId==='controlChart'?280:215);
  const dpr=window.devicePixelRatio||1;
  canvas.width=Math.round(width*dpr);
  canvas.height=Math.round(height*dpr);
  const ctx=canvas.getContext('2d');
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,width,height);

  const g=controlGrouped();
  const maxVal=Math.max(5,...g.estimated,...g.real);
  const step=Math.ceil(maxVal/4)||1;
  const yMax=step*4;

  const padTop=38,padRight=16,padBottom=44,padLeft=42;
  const plotW=width-padLeft-padRight;
  const plotH=height-padTop-padBottom;

  ctx.font='600 11px Inter, system-ui, sans-serif';
  ctx.textBaseline='middle';

  // Leyenda superior
  const legY=14;
  ctx.fillStyle='rgba(183,217,236,.95)';
  ctx.beginPath();ctx.roundRect(padLeft,legY-5,10,10,3);ctx.fill();
  ctx.fillStyle='#52657a';
  ctx.fillText('Horas estimadas',padLeft+15,legY);

  ctx.fillStyle='rgba(37,136,206,.9)';
  ctx.beginPath();ctx.roundRect(padLeft+125,legY-5,10,10,3);ctx.fill();
  ctx.fillStyle='#52657a';
  ctx.fillText('Horas reales',padLeft+140,legY);

  // Líneas de grilla y eje Y
  for(let i=0;i<=4;i++){
    const val=step*i;
    const y=padTop+plotH-(val/yMax)*plotH;
    ctx.strokeStyle='rgba(100,116,139,.14)';
    ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(padLeft,y);ctx.lineTo(width-padRight,y);ctx.stroke();
    ctx.fillStyle='#64748b';
    ctx.font='500 10px Inter, system-ui, sans-serif';
    ctx.textAlign='right';
    ctx.fillText(val+' h',padLeft-7,y);
  }

  // Barras por categoría
  const groupW=plotW/g.labels.length;
  const barW=Math.min(24,Math.max(10,groupW*0.28));
  const gap=Math.min(6,groupW*0.06);

  g.labels.forEach((label,idx)=>{
    const centerX=padLeft+groupW*idx+groupW/2;
    const est=g.estimated[idx]||0;
    const real=g.real[idx]||0;

    const estH=Math.max(0,(est/yMax)*plotH);
    const realH=Math.max(0,(real/yMax)*plotH);

    const xEst=centerX-barW-gap/2;
    const yEst=padTop+plotH-estH;
    const xReal=centerX+gap/2;
    const yReal=padTop+plotH-realH;

    // Barra estimada
    ctx.fillStyle='rgba(183,217,236,.95)';
    if(estH>0){
      ctx.beginPath();ctx.roundRect(xEst,yEst,barW,estH,[5,5,0,0]);ctx.fill();
      ctx.fillStyle='#475569';
      ctx.font='700 10px Inter, system-ui, sans-serif';
      ctx.textAlign='center';
      ctx.fillText(est.toLocaleString('es-CL',{maximumFractionDigits:1}),xEst+barW/2,yEst-8);
    }

    // Barra real
    ctx.fillStyle='rgba(37,136,206,.9)';
    if(realH>0){
      ctx.beginPath();ctx.roundRect(xReal,yReal,barW,realH,[5,5,0,0]);ctx.fill();
      ctx.fillStyle='#1769aa';
      ctx.font='700 10px Inter, system-ui, sans-serif';
      ctx.textAlign='center';
      ctx.fillText(real.toLocaleString('es-CL',{maximumFractionDigits:1}),xReal+barW/2,yReal-8);
    }

    // Etiqueta categoría eje X
    ctx.fillStyle='#64748b';
    ctx.font='600 10px Inter, system-ui, sans-serif';
    ctx.textAlign='center';
    const shortLabel=label.length>15&&width<520?label.slice(0,13)+'…':label;
    ctx.fillText(shortLabel,centerX,padTop+plotH+18);
  });
}

