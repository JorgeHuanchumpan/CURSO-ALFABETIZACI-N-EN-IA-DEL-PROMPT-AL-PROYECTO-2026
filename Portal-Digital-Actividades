const CONTROL_WEIGHT={'Pendiente':0,'En progreso':0.5,'Completada':1};
const $=id=>document.getElementById(id);
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const today=()=>new Date().toISOString().slice(0,10);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function save(){try{localStorage.setItem(KEY,JSON.stringify(data))}catch(e){toast('No fue posible guardar los datos.')} }
function createControlDemo(){const plus=n=>{const d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)};return [
{id:uid(),name:'Preparar planificación semanal',category:'Trabajo',estimated:6,real:4.5,date:plus(2),priority:'Alta',state:'En progreso'},
{id:uid(),name:'Revisar contenidos de formación',category:'Estudio',estimated:5,real:2,date:plus(5),priority:'Media',state:'En progreso'},
{id:uid(),name:'Documentar mejoras del portal',category:'Proyecto Personal',estimated:8,real:0,date:plus(10),priority:'Media',state:'Pendiente'},
{id:uid(),name:'Completar registro de tareas',category:'Tareas Operativas',estimated:3,real:3,date:plus(-2),priority:'Baja',state:'Completada'}]}
function sanitizarControlActivity(a){if(!a||typeof a!=='object')return null;const name=typeof a.name==='string'?a.name.trim():'';const estimated=Number(a.estimated),real=Number(a.real);if(name.length<3||name.length>120||!CONTROL_CATEGORIES.includes(a.category)||!CONTROL_PRIORITIES.includes(a.priority)||!CONTROL_STATES.includes(a.state)||!(estimated>0&&estimated<=10000)||!(real>=0&&real<=10000)||!/^\d{4}-\d{2}-\d{2}$/.test(a.date||''))return null;return {id:typeof a.id==='string'&&a.id?a.id:uid(),name,category:a.category,estimated,real,date:a.date,priority:a.priority,state:a.state}}
function load(){try{const saved=localStorage.getItem(KEY);if(saved){const parsed=JSON.parse(saved);data={...data,...parsed};if(!Array.isArray(parsed.controlActivities)){data.controlActivities=createControlDemo();save();}else{data.controlActivities=parsed.controlActivities.map(sanitizarControlActivity).filter(Boolean);}}else{data.controlActivities=createControlDemo();save();}}catch(e){console.warn('No se pudo leer el almacenamiento local',e);if(!Array.isArray(data.controlActivities))data.controlActivities=[]}}
function toast(msg){const el=$('toast');el.textContent=msg;el.classList.add('show');clearTimeout(window._toastTimer);window._toastTimer=setTimeout(()=>el.classList.remove('show'),2600)}
