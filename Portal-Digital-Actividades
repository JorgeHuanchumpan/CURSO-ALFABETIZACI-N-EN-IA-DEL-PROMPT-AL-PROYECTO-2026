function controlMetrics(list=data.controlActivities){
  const total=list.length,completed=list.filter(a=>a.state==='Completada').length;
  const pending=list.filter(a=>a.state!=='Completada').length;
  const actual=list.reduce((sum,a)=>sum+Number(a.real||0),0);
  const estimated=list.reduce((sum,a)=>sum+Number(a.estimated||0),0);
  const progress=estimated>0?list.reduce((sum,a)=>sum+Number(a.estimated||0)*CONTROL_WEIGHT[a.state],0)/estimated*100:(total?list.reduce((sum,a)=>sum+CONTROL_WEIGHT[a.state],0)/total*100:0);
  return {total,completed,pending,actual,progress,rate:total?completed/total*100:0};
}
function controlGrouped(){return {labels:CONTROL_CATEGORIES,estimated:CONTROL_CATEGORIES.map(c=>data.controlActivities.filter(a=>a.category===c).reduce((v,a)=>v+Number(a.estimated||0),0)),real:CONTROL_CATEGORIES.map(c=>data.controlActivities.filter(a=>a.category===c).reduce((v,a)=>v+Number(a.real||0),0))}}
