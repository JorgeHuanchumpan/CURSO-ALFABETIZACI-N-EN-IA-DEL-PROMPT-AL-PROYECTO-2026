<script>
const KEY='portalDigitalMVP_v1';
const defaultCategories=['Clase','Charla','Conversatorio','Salida a Terreno','Visita Externa','Taller Deportivo'];
let data={activities:[],objectives:[],registrations:[],controlActivities:[],categories:defaultCategories,settings:{org:'Mi organización',admin:'Administrador'}};
let calDate=new Date(), editingId=null, modalType='', controlEditingId=null;
const CONTROL_CATEGORIES=['Trabajo','Estudio','Proyecto Personal','Tareas Operativas','Salud/Bienestar'];
