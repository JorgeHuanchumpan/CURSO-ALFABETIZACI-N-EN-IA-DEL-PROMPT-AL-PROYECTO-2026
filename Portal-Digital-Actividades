<div class="form-group"><label for="aResources">Recursos necesarios</label><input id="aResources" value="${esc(a.resources||'')}" placeholder="Materiales, equipos..."></div>
<div class="form-group"><label for="aResponsible">Responsable</label><input id="aResponsible" value="${esc(a.responsible||'')}" placeholder="Nombre responsable"></div>
<div class="form-group"><label for="aCapacity">Cupos disponibles</label><input type="number" id="aCapacity" min="0" value="${a.capacity??''}" placeholder="Sin límite"></div>
<div class="form-group"><label for="aStatus">Estado</label><select id="aStatus">${['Borrador','Publicada','Finalizada','Cancelada'].map(s=>`<option ${a.status===s?'selected':''}>${s}</option>`).join('')}</select></div>
