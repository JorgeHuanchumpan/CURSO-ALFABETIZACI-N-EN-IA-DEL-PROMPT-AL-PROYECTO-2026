function saveControlActivity(e){e.preventDefault();const form=$('controlActivityForm');if(!form.reportValidity())return;const name=$('ctlName').value.trim(),estimated=Number($('ctlEstimated').value),real=Number($('ctlReal').value),date=$('ctlDate').value,category=$('ctlCategory').value,priority=$('ctlPriority').value,state=$('ctlState').value;
